@page "/viewings/delete"
@using Microsoft.EntityFrameworkCore
@using MovieVault.Models
@inject IDbContextFactory<MovieVault.Data.MovieVaultContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалити перегляд</PageTitle>

<h1>Видалити перегляд</h1>

<h3>Ви впевнені, що хочете видалити цей перегляд?</h3>

@if (viewing is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Твір</dt>
            <dd class="col-sm-10">@viewing.Title?.Name (@viewing.Title?.ReleaseYear)</dd>

            <dt class="col-sm-2">Дата перегляду</dt>
            <dd class="col-sm-10">@viewing.WatchedAt.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-2">Оцінка</dt>
            <dd class="col-sm-10">@viewing.Rating</dd>

            <dt class="col-sm-2">Повторний перегляд</dt>
            <dd class="col-sm-10">@(viewing.IsRewatch ? "Так" : "Ні")</dd>

            <dt class="col-sm-2">Нотатки</dt>
            <dd class="col-sm-10">@viewing.Notes</dd>
        </dl>

        <EditForm method="post" Model="viewing" OnValidSubmit="DeleteViewing" FormName="delete">
            <input type="hidden" name="viewing.Id" value="@viewing.Id" />
            <button type="submit" class="btn btn-danger">Видалити</button> |
            <a href="/viewings">← Повернутися до списку</a>
        </EditForm>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private Viewing? viewing;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        
        // Include обов'язковий, щоб підтягнути назву твору
        viewing = await context.Viewings
            .Include(v => v.Title)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (viewing is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteViewing()
    {
        using var context = DbFactory.CreateDbContext();
        context.Viewings.Remove(viewing!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/viewings");
    }
}