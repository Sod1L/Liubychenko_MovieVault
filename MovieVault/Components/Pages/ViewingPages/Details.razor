@page "/viewings/details"
@using Microsoft.EntityFrameworkCore
@using MovieVault.Models
@inject IDbContextFactory<MovieVault.Data.MovieVaultContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Подробиці перегляду</PageTitle>

<h1>Подробиці перегляду</h1>

@if (viewing is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Твір</dt>
        <dd class="col-sm-10">@viewing.Title?.Name</dd>

        <dt class="col-sm-2">Дата перегляду</dt>
        <dd class="col-sm-10">@viewing.WatchedAt.ToString("dd.MM.yyyy")</dd>

        <dt class="col-sm-2">Оцінка</dt>
        <dd class="col-sm-10">@viewing.Rating</dd>

        <dt class="col-sm-2">Повторний перегляд</dt>
        <dd class="col-sm-10">@(viewing.IsRewatch ? "Так" : "Ні")</dd>

        <dt class="col-sm-2">Нотатки</dt>
        <dd class="col-sm-10">@viewing.Notes</dd>
    </dl>
}

<div>
    <a href="@($"viewings/edit?id={viewing?.Id}")">Редагувати</a> |
    <a href="/viewings">← Повернутися до списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private Viewing? viewing;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        
        viewing = await context.Viewings
            .Include(v => v.Title)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (viewing is null)
        {
            NavigationManager.NotFound();
        }
    }
}