@page "/titles/delete"
@using Microsoft.EntityFrameworkCore
@using MovieVault.Models
@inject IDbContextFactory<MovieVault.Data.MovieVaultContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалити твір</PageTitle>

<h1>Видалити твір</h1>

<h3>Ви впевнені, що хочете видалити цей запис?</h3>

@if (title is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <h4>Картки</h4>
    <hr />

    <TitleCard Item="title" Caption="Запис, який буде видалено" ShowDetails="false" />

    <EditForm method="post" Model="title" OnValidSubmit="DeleteTitle" FormName="delete">
        <input type="hidden" name="Title.Id" value="@title!.Id" />
        <button type="submit" class="btn btn-danger">Видалити</button> |
        <a href="titles">← Назад до каталогу</a>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Title? title { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        title ??= await context.Titles.FirstOrDefaultAsync(m => m.Id == Id);
        if (title is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteTitle()
    {
        using var context = DbFactory.CreateDbContext();
        context.Titles.Remove(title!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("titles");
    }
}