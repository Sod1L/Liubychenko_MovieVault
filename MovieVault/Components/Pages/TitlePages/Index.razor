@page "/titles"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MovieVault.Models
@inject IDbContextFactory<MovieVault.Data.MovieVaultContext> DbFactory

<PageTitle>Каталог</PageTitle>

<h1>Каталог</h1>

<p>
    <a href="titles/create" class="btn btn-success">Додати твір</a>
</p>

<!-- ФОРМА ПОШУКУ ТА ФІЛЬТРІВ -->
<form method="get" class="row g-2 mb-4 p-3 bg-light rounded border">
    <div class="col-md-4">
        <input name="search" value="@Search" class="form-control" placeholder="Пошук за назвою..." />
    </div>
    <div class="col-md-3">
        <select name="genreId" class="form-select">
            <option value="">Усі жанри</option>
            @foreach (var g in genres)
            {
                <option value="@g.Id" selected="@(GenreId == g.Id)">@g.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="sort" class="form-select">
            <option value="name_asc" selected="@(Sort == "name_asc" || string.IsNullOrEmpty(Sort))">За назвою (А-Я)</option>
            <option value="name_desc" selected="@(Sort == "name_desc")">За назвою (Я-А)</option>
            <option value="year_desc" selected="@(Sort == "year_desc")">За роком (новіші)</option>
            <option value="year_asc" selected="@(Sort == "year_asc")">За роком (старіші)</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Шукати</button>
    </div>
</form>

<!-- ТАБЛИЦЯ -->
<QuickGrid Class="table table-hover" Items="@titles.Skip((CurrentPage - 1) * PageSize).Take(PageSize).AsQueryable()">
    <PropertyColumn Property="title => title.Name" Title="Назва" />
    <PropertyColumn Property="title => title.OriginalName" Title="Оригінальна назва" />
    <TemplateColumn Title="Тип твору" Context="title">
        @(title.Kind == TitleKind.Film ? "Фільм" : "Серіал")
    </TemplateColumn>
    <PropertyColumn Property="title => title.Genre!.Name" Title="Жанр" />
    <PropertyColumn Property="title => title.ReleaseYear" Title="Рік випуску" />
    <TemplateColumn Title="Тривалість (хв)" Context="title">
        @(title.DurationMinutes?.ToString() ?? "—")
    </TemplateColumn>
    <PropertyColumn Property="title => title.Country" Title="Країна" />
    <PropertyColumn Property="title => title.AddedOn" Title="Дата додавання" />
    <PropertyColumn Property="title => title.Viewings.Count" Title="Переглядів" />
    <TemplateColumn Title="Дії" Context="title">
        <a href="@($"titles/edit?id={title.Id}")">Редагувати</a> |
        <a href="@($"titles/details?id={title.Id}")">Деталі</a> |
        <a href="@($"titles/delete?id={title.Id}")">Видалити</a>
    </TemplateColumn>
</QuickGrid>

<!-- ПАГІНАЦІЯ -->
<nav class="mt-3">
    @if (CurrentPage > 1)
    {
        <a class="btn btn-outline-secondary" href="@($"titles?page={CurrentPage - 1}&search={Search}&genreId={GenreId}&sort={Sort}")">Назад</a>
    }
    <span class="mx-2">Сторінка @CurrentPage</span>
    @if (titles.Count > CurrentPage * PageSize)
    {
        <a class="btn btn-outline-secondary" href="@($"titles?page={CurrentPage + 1}&search={Search}&genreId={GenreId}&sort={Sort}")">Далі</a>
    }
</nav>

@code {
    private List<Title> titles = new();
    private List<Genre> genres = new();

    private const int PageSize = 10;

    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public int? GenreId { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }

    private int CurrentPage => Page is > 0 ? Page.Value : 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        
        genres = await db.Genres.OrderBy(g => g.Name).ToListAsync();

        // Будуємо запит
        var query = db.Titles
            .Include(t => t.Genre)
            .Include(t => t.Viewings)
            .AsQueryable();

        // Фільтр за пошуком
        if (!string.IsNullOrWhiteSpace(Search))
        {
            var s = Search.ToLowerInvariant();
            query = query.Where(t => t.NameSearch.Contains(s));
        }

        // Фільтр за жанром
        if (GenreId is int gid)
        {
            query = query.Where(t => t.GenreId == gid);
        }

        query = Sort switch
        {
            "year_desc" => query.OrderByDescending(t => t.ReleaseYear),
            "year_asc" => query.OrderBy(t => t.ReleaseYear),
            "name_desc" => query.OrderByDescending(t => t.Name),
            _ => query.OrderBy(t => t.Name) 
        };

        titles = await query.ToListAsync();
    }
}