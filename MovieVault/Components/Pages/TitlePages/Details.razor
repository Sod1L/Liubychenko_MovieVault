@page "/titles/details"
@using Microsoft.EntityFrameworkCore
@using MovieVault.Models
@inject IDbContextFactory<MovieVault.Data.MovieVaultContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Подробиці твору</PageTitle>

<h1>Подробиці твору</h1>

@if (title is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <TitleCard Item="title" Caption="Подробиці запису" />

    <div class="mt-3">
        <a href="@($"titles/edit?id={title.Id}")" class="btn btn-primary">Редагувати</a>
        <a href="titles" class="btn btn-outline-secondary">← Повернутися до списку</a>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private Title? title;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        
        // ← ОСЬ ТУТ додано Include(t => t.Genre)
        title = await context.Titles
            .Include(t => t.Genre)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (title is null)
        {
            NavigationManager.NotFound();
        }
    }
}