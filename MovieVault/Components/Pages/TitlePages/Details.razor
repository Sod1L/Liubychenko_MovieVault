@page "/titles/details"
@using Microsoft.EntityFrameworkCore
@using MovieVault.Models
@inject IDbContextFactory<MovieVault.Data.MovieVaultContext> DbFactory

<PageTitle>Подробиці – MovieVault</PageTitle>

<h1>Подробиці твору</h1>

@if (title is null)
{
    <div class="alert alert-warning mt-3">
        Запис не знайдено — можливо, його видалено. 
        <a href="/titles">Повернутися до переліку</a>.
    </div>
}
else
{
    <TitleCard Item="title" Caption="Подробиці запису" />

    <div class="mt-3">
        <a href="@($"titles/edit?id={title.Id}")" class="btn btn-primary">Редагувати</a>
        <a href="/titles" class="btn btn-outline-secondary">← Повернутися до списку</a>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private Title? title;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        
        title = await context.Titles
            .Include(t => t.Genre)
            .FirstOrDefaultAsync(m => m.Id == Id);
    }
}